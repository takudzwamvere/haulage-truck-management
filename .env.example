# Django secret key (generate a unique, cryptographically random string for production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Debug mode (set to True for local development, MUST be False in production)
DEBUG=False

# Comma-separated hostnames allowed to serve requests (.vercel.app is included automatically)
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Comma-separated origins allowed for CSRF-protected POST requests
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,http://localhost:8000

# Pooled PostgreSQL connection string for application runtime (e.g. Neon PgBouncer pooler endpoint)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Direct unpooled PostgreSQL connection string for running migrations and DDL operations
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Object Storage S3 access key ID
AWS_ACCESS_KEY_ID=your-neon-s3-access-key-id

# Neon Object Storage S3 secret access key
AWS_SECRET_ACCESS_KEY=your-neon-s3-secret-access-key

# Neon Object Storage S3 endpoint URL (e.g. https://storage.neon.tech)
AWS_ENDPOINT_URL_S3=https://storage.neon.tech

# Neon Object Storage S3 AWS region identifier (defaults to us-east-1)
AWS_REGION=us-east-1

# S3 bucket name for uploads (defaults to assets)
AWS_STORAGE_BUCKET_NAME=assets

# Optional log directory for local Docker container logging (stdout is used in serverless/Vercel)
LOG_DIR=logs
