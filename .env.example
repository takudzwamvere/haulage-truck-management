# Haulage Truck Management - Environment Configuration

# Django secret key (generate a unique, random string in production)
SECRET_KEY=assessor-secret-key-change-in-production

# Enable debug mode for development (set to False in production)
DEBUG=False

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted CSRF origins with scheme
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# PostgreSQL database connection string
DATABASE_URL=postgres://haulage_user:haulage_pass@localhost:5432/haulage
